# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_db?schema=public"

# Порт сервера
PORT=3000

# JWT секрет (для авторизации)
JWT_SECRET=your-secret-key-here

# Учётная запись администратора (создаётся при первом запуске, если нет пользователей)
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@crm.local